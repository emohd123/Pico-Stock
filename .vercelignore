# The Event Studio runtime reads only the small seed and catalogue registry.
# Source extraction caches and finished Blender/render files are held in private cloud storage.
private/event-studio/rbc/*
!private/event-studio/rbc/site-seed.json
!private/event-studio/rbc/furniture-assets.json
